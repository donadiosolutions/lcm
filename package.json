{
  "name": "@donadiosolutions/lcm",
  "version": "1.4.3",
  "description": "Never lose context again. Long Context Manager (LCM) compresses Claude Code sessions into searchable memory — every message preserved, every insight remembered.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/src/memory/index.js",
  "exports": {
    ".": "./dist/src/memory/index.js"
  },
  "bin": {
    "lcm": "dist/bin/lcm.js"
  },
  "license": "MIT",
  "author": "Pedro Almeida (https://github.com/ipedro)",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "context-management",
    "llm",
    "summarization",
    "conversation-memory",
    "dag"
  ],
  "files": [
    "dist/",
    "mcp.mjs",
    "lcm.mjs",
    ".claude-plugin/",
    "!.claude-plugin/commands/lcm-dogfood.md",
    "!.claude-plugin/skills/lcm-dogfood/",
    "!.claude-plugin/skills/lcm-e2e/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "mkdir -p dist/src/prompts && cp -r src/prompts/*.yaml dist/src/prompts/ && mkdir -p dist/src/connectors/templates && cp -r src/connectors/templates/. dist/src/connectors/templates/ && cp installer/setup.sh dist/installer/setup.sh && npm run build:plugin-bundles",
    "build:plugin-bundles": "node scripts/build-plugin-bundles.mjs",
    "check:plugin-bundles": "node scripts/build-plugin-bundles.mjs --check",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "lint": "eslint .",
    "release:verify": "npm test && npm pack --dry-run",
    "test": "vitest run --dir test",
    "test:ci": "vitest run --dir test --coverage --coverage.reporter=lcov --coverage.reporter=text --reporter=default --reporter=junit --outputFile=test-report.junit.xml",
    "typecheck": "tsc --noEmit",
    "version-packages": "changeset version && node scripts/sync-plugin-version.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@sinclair/typebox": "0.34.51",
    "body-parser": "2.3.0",
    "commander": "15.0.0",
    "fast-uri": "3.1.5",
    "js-yaml": "5.2.2",
    "safe-regex": "2.1.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.111.0",
    "@changesets/cli": "2.31.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.1",
    "@types/safe-regex": "1.1.6",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "openai": "6.46.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "0.111.0",
    "openai": "6.46.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "overrides": {
    "read-yaml-file": "2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donadiosolutions/lcm.git"
  },
  "homepage": "https://github.com/donadiosolutions/lcm#readme",
  "bugs": {
    "url": "https://github.com/donadiosolutions/lcm/issues"
  }
}
