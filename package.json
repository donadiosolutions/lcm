{
  "name": "@donadiosolutions/lcm",
  "version": "1.4.2",
  "description": "Never lose context again. Long Context Manager (LCM) compresses Claude Code sessions into searchable memory — every message preserved, every insight remembered.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/src/memory/index.js",
  "exports": {
    ".": "./dist/src/memory/index.js",
    "./storage/native-transcripts": {
      "types": "./dist/src/storage/native-transcripts.d.ts",
      "import": "./dist/src/storage/native-transcripts.js"
    }
  },
  "bin": {
    "lcm": "dist/lcm.mjs"
  },
  "license": "MIT",
  "author": "Donadio Solutions (https://github.com/donadiosolutions)",
  "keywords": [
    "claude-code",
    "context-management",
    "llm",
    "summarization",
    "conversation-memory",
    "dag"
  ],
  "files": [
    "dist/",
    "docs/",
    "README.md",
    "ACKNOWLEDGMENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "mkdir -p dist/src/prompts && cp -r src/prompts/*.yaml dist/src/prompts/ && mkdir -p dist/src/connectors/templates && cp -r src/connectors/templates/. dist/src/connectors/templates/ && mkdir -p dist/src/storage/postgresql/migrations && cp src/storage/postgresql/migrations/*.sql dist/src/storage/postgresql/migrations/ && cp installer/setup.sh dist/installer/setup.sh && npm run build:runtime && npm run verify:native-transcript-package",
    "build:runtime": "node scripts/build-runtime.mjs",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "lint": "eslint .",
    "release:verify": "npm test && npm run verify:consumer-topology && npm pack --dry-run",
    "test": "vitest run --dir test",
    "test:ci": "vitest run --dir test --coverage --coverage.reporter=lcov --coverage.reporter=text --reporter=default --reporter=junit --outputFile=test-report.junit.xml",
    "test:postgresql": "npm run build && node scripts/postgresql-harness.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.postgresql-conformance.json",
    "verify:consumer-topology": "node scripts/verify-consumer-topology.mjs",
    "verify:native-transcript-package": "node scripts/verify-native-transcript-package.mjs && tsc --project tsconfig.native-transcript-package.json",
    "version-packages": "node scripts/version-packages.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@sinclair/typebox": "0.34.52",
    "commander": "15.0.0",
    "js-yaml": "5.2.2",
    "pg": "8.22.0",
    "safe-regex": "2.1.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@changesets/cli": "2.31.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/safe-regex": "1.1.6",
    "@vitest/coverage-v8": "4.1.10",
    "body-parser": "2.3.0",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "fast-uri": "3.1.4",
    "openai": "6.49.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "openai": "6.49.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "overrides": {
    "read-yaml-file": "2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donadiosolutions/lcm.git"
  },
  "homepage": "https://github.com/donadiosolutions/lcm#readme",
  "bugs": {
    "url": "https://github.com/donadiosolutions/lcm/issues"
  }
}
