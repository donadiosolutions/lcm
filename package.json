{
  "name": "@donadiosolutions/lcm",
  "version": "1.4.2",
  "description": "Never lose context again. Long Context Manager (LCM) compresses Claude Code sessions into searchable memory — every message preserved, every insight remembered.",
  "type": "module",
  "engines": {
    "node": ">=25.4.0"
  },
  "main": "dist/src/memory/index.js",
  "exports": {
    ".": "./dist/src/memory/index.js",
    "./storage/native-transcripts": {
      "types": "./dist/src/storage/native-transcripts.d.ts",
      "import": "./dist/src/storage/native-transcripts.js"
    },
    "./storage/postgresql": {
      "types": "./dist/src/storage/postgresql.d.ts",
      "import": "./dist/src/storage/postgresql.js"
    },
    "./storage/portable": {
      "types": "./dist/src/storage/portable.d.ts",
      "import": "./dist/src/storage/portable.js"
    }
  },
  "bin": {
    "lcm": "dist/lcm.mjs"
  },
  "license": "MIT",
  "author": "Donadio Solutions (https://github.com/donadiosolutions)",
  "keywords": [
    "claude-code",
    "context-management",
    "llm",
    "summarization",
    "conversation-memory",
    "dag"
  ],
  "files": [
    "dist/",
    "docs/README.md",
    "docs/agent-tools.md",
    "docs/architecture.md",
    "docs/backend-parity.md",
    "docs/backend-publication.md",
    "docs/cli.md",
    "docs/configuration.md",
    "docs/daemon-restart-recovery.md",
    "docs/daemon-temporary-storage.md",
    "docs/development.md",
    "docs/external-admission.md",
    "docs/fts5.md",
    "docs/hook-protocol.md",
    "docs/implement-epic.md",
    "docs/incident-diagnostics.md",
    "docs/issue-triage.md",
    "docs/migration-cutover-set.md",
    "docs/migration-cutover.md",
    "docs/migration-operations.md",
    "docs/migration-rehearsal-gate.json",
    "docs/migration-rehearsal-gate.md",
    "docs/migration-rehearsal.md",
    "docs/migration-rollback.md",
    "docs/passive-learning.md",
    "docs/portable-knowledge.md",
    "docs/portable-record-stream.md",
    "docs/portable-transfer.md",
    "docs/privacy.md",
    "docs/procedural-development.md",
    "docs/production-certification.md",
    "docs/project-identity.md",
    "docs/releasing.md",
    "docs/tag-schema.md",
    "docs/triage-fix-all-bugs.md",
    "docs/triage-security-issues.md",
    "docs/vscode-codex.md",
    "src/storage/postgresql/reference/",
    "README.md",
    "ACKNOWLEDGMENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "mkdir -p dist/src/prompts && cp -r src/prompts/*.yaml dist/src/prompts/ && node -e \"const fs = require('node:fs'); for (const [path, recursive] of [['dist/src/connectors/templates', true], ['dist/src/connectors/operation-catalog.js', false], ['dist/src/connectors/operation-catalog.d.ts', false], ['dist/src/connectors/operation-catalog.js.map', false]]) { try { fs.rmSync(path, { recursive }); } catch (error) { if (error.code !== 'ENOENT') throw error; } }\" && mkdir -p dist/src/connectors/templates && cp -r src/connectors/templates/. dist/src/connectors/templates/ && mkdir -p dist/src/storage/postgresql/migrations && cp src/storage/postgresql/migrations/*.sql dist/src/storage/postgresql/migrations/ && cp installer/setup.sh dist/installer/setup.sh && pnpm run build:runtime && pnpm run verify:native-transcript-package && pnpm run verify:postgresql-package && pnpm run verify:portable-package",
    "build:runtime": "node scripts/build-runtime.mjs",
    "prepublishOnly": "pnpm run build",
    "changeset": "changeset",
    "lint": "eslint .",
    "release:verify": "pnpm run test && pnpm run verify:consumer-topology && npm pack --dry-run",
    "test": "vitest run --dir test",
    "test:ci": "vitest run --dir test --coverage --coverage.reporter=lcov --coverage.reporter=text --reporter=default --reporter=junit",
    "test:surface-parity:inventory": "node scripts/generate-surface-parity-inventory.mjs",
    "test:postgresql": "pnpm run build && node scripts/postgresql-harness.mjs",
    "test:postgresql:census-cost": "pnpm run build && LCM_TEST_POSTGRES_CENSUS_COST=true node scripts/postgresql-harness.mjs",
    "test:postgresql:cutover-rehearsal": "pnpm run build && LCM_TEST_POSTGRES_CUTOVER_REHEARSAL=true node scripts/postgresql-harness.mjs",
    "test:certification:local": "LCM_TEST_CONTAINER_CLI=podman timeout -k 60 10800 node scripts/certification-harness.mjs --lane local",
    "test:certification:managed": "node scripts/certification-harness.mjs --lane managed",
    "test:certification:gate": "node --experimental-strip-types scripts/certification-gate.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.postgresql-conformance.json && tsc --project tsconfig.promotion-type-regression.json && tsc --project tsconfig.identity-binding-type-regression.json",
    "verify:consumer-topology": "node scripts/verify-consumer-topology.mjs",
    "verify:native-transcript-package": "node scripts/verify-native-transcript-package.mjs && tsc --project tsconfig.native-transcript-package.json",
    "verify:postgresql-package": "node scripts/verify-postgresql-package.mjs && tsc --project tsconfig.postgresql-package.json",
    "version-packages": "node scripts/version-packages.mjs",
    "update:patterns": "node --experimental-strip-types scripts/update-gitleaks-patterns.ts",
    "verify:portable-package": "node scripts/verify-portable-package.mjs && tsc --project tsconfig.portable-package.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@sinclair/typebox": "0.34.52",
    "@types/pg": "8.23.1",
    "commander": "15.0.0",
    "js-yaml": "5.5.0",
    "pg": "8.23.1",
    "safe-regex": "2.1.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@changesets/cli": "3.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.5",
    "@types/safe-regex": "1.1.6",
    "@vitest/coverage-v8": "4.1.12",
    "body-parser": "2.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "fast-uri": "4.2.3",
    "openai": "7.36.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "openai": "7.36.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donadiosolutions/lcm.git"
  },
  "homepage": "https://github.com/donadiosolutions/lcm#readme",
  "bugs": {
    "url": "https://github.com/donadiosolutions/lcm/issues"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
